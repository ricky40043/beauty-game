# 地端部署用的設定。複製到 server 上的 /opt/beauty-game/.env 再填實際值。
# 這個檔案本身不含機密，可以進版控；填好值的 .env 不要進版控。

# 你在 Cloudflare 上要對外的網址。QR code 依這個產生，設錯手機掃了會連不到。
FRONTEND_URL=https://game.example.com

# 示範圖後台（/admin）的上傳與刪除密碼。對外服務一定要設，而且要夠長。
# 產生方式：openssl rand -base64 24
ADMIN_TOKEN=

# Cloudflare Zero Trust → Networks → Tunnels 建立通道後給你的 token
CLOUDFLARE_TUNNEL_TOKEN=
