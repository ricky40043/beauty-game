# 伺服器
PORT=8081
HOST=localhost
ENV=development

# QR code 會指向這個網址（本機開發用 Vite 的 3344）
FRONTEND_URL=http://localhost:3344
CORS_ORIGINS=http://localhost:3344

# 遊戲預設值
MAX_PLAYERS_PER_ROOM=30
ROOM_ID_LENGTH=6
QUESTION_TIME_LIMIT=60
DEFAULT_TOTAL_QUESTIONS=10

# 照片限制（純記憶體儲存）
MAX_PHOTO_BYTES=8388608
MAX_ROOM_PHOTOS=300
MAX_ROOM_BYTES=83886080

# 題目示範圖
# 內建的火柴人示範圖在程式裡；房主從 /admin 上傳的圖存在這個資料夾
EXAMPLE_DIR=./data/examples
# 設了之後 /admin 的上傳與刪除都需要這組密碼（留空 = 不驗證，僅適合本機）
ADMIN_TOKEN=
